  // Función para analizar la pregunta y encontrar la mejor respuesta
  function getBotResponse(userMessage: string): string {
    const messageLower = userMessage.toLowerCase();
    const words = messageLower.split(/\s+/);
    
    let bestMatch = null;
    let highestScore = 0;
    
    // Buscar coincidencias en la base de conocimientos
    for (const [category, data] of Object.entries(amarantoKnowledge)) {
      let score = 0;
      
      // Contar coincidencias de keywords
      for (const keyword of data.keywords) {
        if (messageLower.includes(keyword)) {
          score += 1;
          
          // Dar más peso a coincidencias exactas de palabras completas
          if (words.includes(keyword)) {
            score += 2;
          }
          
          // Dar aún más peso si la keyword es más específica (más larga)
          if (keyword.length > 6) {
            score += 1;
          }
        }
      }
      
      if (score > highestScore) {
        highestScore = score;
        bestMatch = data;
      }
    }
    
    // Si no hay coincidencia suficiente, usar respuesta por defecto
    if (highestScore === 0) {
      return `Gracias por tu pregunta. Puedo ayudarte con información sobre:

• Beneficios y propiedades del amaranto
• Información nutricional
• Recetas y formas de preparación
• Nuestros productos
• Cultivo en Sololá
• Contacto y compras

¿Sobre qué tema específico te gustaría saber más?`;
    }
    
    return bestMatch.response;
  }

  // Función para agregar un mensaje al chat
  function addMessage(content: string, isUser: boolean = false) {
    const messagesContainer = document.getElementById('chatMessages');
    if (!messagesContainer) return;

    const messageDiv = document.createElement('div');
    messageDiv.className = `message ${isUser ? 'user-message' : 'bot-message'}`;
    
    const now = new Date();
    const timeStr = now.toLocaleTimeString('es-GT', { hour: '2-digit', minute: '2-digit' });
    
    if (isUser) {
      messageDiv.innerHTML = `
        <div class="message-avatar">Tú</div>
        <div class="message-content">
          <div class="message-bubble">
            <p>${content}</p>
          </div>
          <span class="message-time">${timeStr}</span>
        </div>
      `;
    } else {
      messageDiv.innerHTML = `
        <div class="message-avatar">
          <img src="/logo-amaranto.png" alt="Bot" />
        </div>
        <div class="message-content">
          <div class="message-bubble">
            ${content.split('\n').map(line => {
              if (line.trim().startsWith('•')) {
                return `<p>${line}</p>`;
              } else if (line.trim().startsWith('**') && line.trim().endsWith('**')) {
                return `<p><strong>${line.replace(/\*\*/g, '')}</strong></p>`;
              } else if (line.trim()) {
                return `<p>${line}</p>`;
              }
              return '';
            }).join('')}
          </div>
          <span class="message-time">${timeStr}</span>
        </div>
      `;
    }
    
    messagesContainer.appendChild(messageDiv);
    
    // Comportamiento diferente según el tipo de mensaje
    if (isUser) {
      // Mensaje del usuario: scroll al final para ver lo que escribió
      setTimeout(() => {
        messagesContainer.scrollTo({
          top: messagesContainer.scrollHeight,
          behavior: 'smooth'
        });
      }, 50);
    } else {
      // Respuesta del bot: scroll al INICIO del mensaje nuevo
      setTimeout(() => {
        const messageTop = messageDiv.offsetTop - 150; // 20px de padding
        messagesContainer.scrollTo({
          top: messageTop,
          behavior: 'smooth'
        });
      }, 100);
    }
  }

  // Función para mostrar indicador de escritura
  function showTypingIndicator() {
    const typingIndicator = document.getElementById('typingIndicator');
    if (typingIndicator) {
      typingIndicator.classList.add('active');
    }
  }

  // Función para ocultar indicador de escritura
  function hideTypingIndicator() {
    const typingIndicator = document.getElementById('typingIndicator');
    if (typingIndicator) {
      typingIndicator.classList.remove('active');
    }
  }

  // Función para simular respuesta del bot con delay
  async function sendBotResponse(userMessage: string) {
    showTypingIndicator();
    
    // Simular tiempo de "pensamiento" del bot
    await new Promise(resolve => setTimeout(resolve, 1000 + Math.random() * 1000));
    
    hideTypingIndicator();
    const response = getBotResponse(userMessage);
    addMessage(response, false);
  }

  // Función para enviar mensaje del usuario
  async function sendUserMessage() {
    const input = document.getElementById('chatInput') as HTMLTextAreaElement;
    if (!input) return;
    
    const message = input.value.trim();
    if (!message) return;
    
    // Agregar mensaje del usuario
    addMessage(message, true);
    input.value = '';
    input.style.height = 'auto';
    
    // NO ocultar sugerencias - se mantienen siempre visibles
    // Comentado para mantener las sugerencias:
    // const suggestions = document.getElementById('quickSuggestions');
    // if (suggestions && suggestions.style.display !== 'none') {
    //   suggestions.style.display = 'none';
    // }
    
    // Enviar respuesta del bot
    await sendBotResponse(message);
  }

  // Inicialización cuando el DOM está listo
  document.addEventListener('DOMContentLoaded', function() {
    const chatFab = document.getElementById('chatFab');
    const chatContainer = document.getElementById('chatContainer');
    const minimizeBtn = document.getElementById('minimizeBtn');
    const sendBtn = document.getElementById('sendBtn');
    const chatInput = document.getElementById('chatInput') as HTMLTextAreaElement;
    const notificationBadge = document.getElementById('notificationBadge');
    const suggestionChips = document.querySelectorAll('.suggestion-chip');

    let isOpen = false;

    // Toggle del chat
    chatFab?.addEventListener('click', function() {
      isOpen = !isOpen;
      chatFab.classList.toggle('active');
      chatContainer?.classList.toggle('active');
      
      // Ocultar badge de notificación
      if (isOpen && notificationBadge) {
        notificationBadge.classList.add('hidden');
      }
      
      // Focus en el input cuando se abre
      if (isOpen && chatInput) {
        setTimeout(() => chatInput.focus(), 300);
      }
    });

    // Minimizar chat
    minimizeBtn?.addEventListener('click', function() {
      isOpen = false;
      chatFab?.classList.remove('active');
      chatContainer?.classList.remove('active');
    });

    // Enviar mensaje con botón
    sendBtn?.addEventListener('click', sendUserMessage);

    // Enviar mensaje con Enter (Shift+Enter para nueva línea)
    chatInput?.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendUserMessage();
      }
    });

    // Auto-resize del textarea
    chatInput?.addEventListener('input', function() {
      this.style.height = 'auto';
      this.style.height = Math.min(this.scrollHeight, 120) + 'px';
    });

    // Sugerencias rápidas
    suggestionChips.forEach(chip => {
      chip.addEventListener('click', function() {
        const question = this.getAttribute('data-question');
        if (question && chatInput) {
          chatInput.value = question;
          sendUserMessage();
        }
      });
    });

    // Mostrar notificación después de 5 segundos si no ha interactuado
    setTimeout(() => {
      if (!isOpen && notificationBadge) {
        notificationBadge.classList.remove('hidden');
      }
    }, 5000);
  });
</script>