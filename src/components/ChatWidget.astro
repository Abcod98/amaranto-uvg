---
// ChatWidget.astro - Widget de chat con IA para información de amaranto
// Versión con paleta de colores del amaranto y alta legibilidad
---

<!-- Botón flotante para abrir el chat -->
<button class="chat-fab" aria-label="Abrir chat de ayuda" id="chatFab">
  <svg class="chat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    <path d="M8 10h.01M12 10h.01M16 10h.01"/>
  </svg>
  <svg class="close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
    <line x1="18" y1="6" x2="6" y2="18"/>
    <line x1="6" y1="6" x2="18" y2="18"/>
  </svg>
  <span class="notification-badge" id="notificationBadge">1</span>
</button>

<!-- Ventana del chat -->
<div class="chat-container" id="chatContainer">
  <div class="chat-header">
    <div class="chat-header-info">
      <div class="chat-avatar">
        <img src="/logo-amaranto.png" alt="Asistente Amaranto" />
        <span class="status-indicator"></span>
      </div>
      <div class="chat-header-text">
        <h3 class="chat-title">Asistente Amaranto</h3>
        <p class="chat-status">En línea • Responde al instante</p>
      </div>
    </div>
    <button class="minimize-btn" id="minimizeBtn" aria-label="Minimizar chat">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
    </button>
  </div>

  <div class="chat-messages" id="chatMessages">
    <!-- Mensaje de bienvenida -->
    <div class="message bot-message">
      <div class="message-avatar">
        <img src="/logo-amaranto.png" alt="Bot" />
      </div>
      <div class="message-content">
        <div class="message-bubble">
          <p>¡Hola! 👋 Soy tu asistente virtual de Amaranto Guatemala.</p>
          <p>Puedo ayudarte con información sobre:</p>
          <ul>
            <li>🌾 Propiedades del amaranto</li>
            <li>💪 Beneficios nutricionales</li>
            <li>🍳 Recetas y formas de preparación</li>
            <li>📦 Nuestros productos</li>
            <li>🌱 Cultivo en Sololá</li>
          </ul>
          <p><strong>¿En qué puedo ayudarte hoy?</strong></p>
        </div>
        <span class="message-time">Ahora</span>
      </div>
    </div>
  </div>

  <!-- Sugerencias rápidas -->
  <div class="quick-suggestions" id="quickSuggestions">
    <button class="suggestion-chip" data-question="¿Qué beneficios tiene el amaranto?">
      💪 Beneficios
    </button>
    <button class="suggestion-chip" data-question="¿Cómo se prepara el amaranto?">
      🍳 Recetas
    </button>
    <button class="suggestion-chip" data-question="¿Qué productos tienen disponibles?">
      📦 Productos
    </button>
    <button class="suggestion-chip" data-question="¿El amaranto tiene gluten?">
      🌾 Sin Gluten
    </button>
    <button class="suggestion-chip" data-question="¿De dónde es el amaranto?">
      🏔️ Sololá
    </button>
    <button class="suggestion-chip" data-question="¿Cómo contactar?">
      📱 Contacto
    </button>
  </div>

  <!-- Indicador de escritura -->
  <div class="typing-indicator" id="typingIndicator">
    <div class="typing-dots">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <span class="typing-text">Escribiendo...</span>
  </div>

  <div class="chat-input-container">
    <div class="chat-input-wrapper">
      <button class="input-action-btn" id="emojiBtn" aria-label="Emojis">
        😊
      </button>
      <textarea
        class="chat-input"
        id="chatInput"
        placeholder="Escribe tu pregunta sobre amaranto..."
        rows="1"
        aria-label="Escribe tu mensaje"
      ></textarea>
      <button class="send-btn" id="sendBtn" aria-label="Enviar mensaje">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </div>
    <div class="chat-footer-info">
      <span class="powered-by">
        <svg viewBox="0 0 24 24" fill="currentColor" class="ai-icon">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
        Asistente virtual inteligente
      </span>
    </div>
  </div>
</div>

<style>
  /* Variables de color - Paleta del Amaranto */
  :root {
    --amaranto-dark: #4A1942;
    --amaranto-primary: #6B2D5C;
    --amaranto-medium: #8B4789;
    --amaranto-light: #A855A3;
    --amaranto-bright: #E879F9;
    --amaranto-purple: #C084FC;
    --amaranto-violet: #A855F7;
    
    /* Colores de fondo y texto optimizados para legibilidad */
    --bg-primary: #FFFFFF;
    --bg-secondary: #FAF8FB;
    --bg-tertiary: #F5F0F7;
    --text-primary: #2D1B3D;
    --text-secondary: #5A4A66;
    --text-muted: #7A6B8A;
    --border-color: #E5D9ED;
    --shadow-sm: 0 2px 8px rgba(107, 45, 92, 0.08);
    --shadow-md: 0 4px 16px rgba(107, 45, 92, 0.12);
    --shadow-lg: 0 12px 40px rgba(107, 45, 92, 0.15);
  }

  /* Botón flotante (FAB) */
  .chat-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, var(--amaranto-primary), var(--amaranto-medium));
    border: none;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(107, 45, 92, 0.4);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-fab:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 30px rgba(107, 45, 92, 0.5);
    background: linear-gradient(135deg, var(--amaranto-medium), var(--amaranto-light));
  }

  .chat-fab:active {
    transform: scale(0.95);
  }

  .chat-icon,
  .close-icon {
    width: 28px;
    height: 28px;
    stroke: white;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: all 0.3s ease;
  }

  .close-icon {
    position: absolute;
    opacity: 0;
    transform: rotate(-90deg);
  }

  .chat-fab.active .chat-icon {
    opacity: 0;
    transform: rotate(90deg);
  }

  .chat-fab.active .close-icon {
    opacity: 1;
    transform: rotate(0deg);
  }

  .notification-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    background: var(--amaranto-bright);
    color: white;
    font-size: 12px;
    font-weight: 700;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid white;
    animation: pulse 2s infinite;
  }

  .notification-badge.hidden {
    display: none;
  }

  /* Contenedor del chat */
  .chat-container {
    position: fixed;
    bottom: 100px;
    right: 24px;
    width: 420px;
    max-width: calc(100vw - 48px);
    height: 600px;
    max-height: calc(100vh - 150px);
    background: var(--bg-primary);
    border-radius: 24px;
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    pointer-events: none;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 998;
    overflow: hidden;
    border: 1px solid var(--border-color);
  }

  .chat-container.active {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: all;
  }

  /* Header del chat */
  .chat-header {
    background: linear-gradient(135deg, var(--amaranto-primary), var(--amaranto-medium));
    color: white;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 24px 24px 0 0;
    box-shadow: 0 2px 10px rgba(107, 45, 92, 0.2);
  }

  .chat-header-info {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .chat-avatar {
    position: relative;
    width: 48px;
    height: 48px;
  }

  .chat-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(255, 255, 255, 0.3);
  }

  .status-indicator {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 12px;
    height: 12px;
    background: #4ade80;
    border: 2px solid white;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .chat-header-text {
    flex: 1;
  }

  .chat-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 2px 0;
  }

  .chat-status {
    font-size: 0.85rem;
    opacity: 0.95;
    margin: 0;
  }

  .minimize-btn {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .minimize-btn:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .minimize-btn svg {
    width: 20px;
    height: 20px;
    stroke: white;
    stroke-width: 2;
  }

  /* Área de mensajes */
  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    background: var(--bg-secondary);
    scroll-behavior: smooth;
  }

  .chat-messages::-webkit-scrollbar {
    width: 6px;
  }

  .chat-messages::-webkit-scrollbar-track {
    background: transparent;
  }

  .chat-messages::-webkit-scrollbar-thumb {
    background: var(--amaranto-purple);
    border-radius: 3px;
  }

  .chat-messages::-webkit-scrollbar-thumb:hover {
    background: var(--amaranto-medium);
  }

  .message {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
    animation: messageSlideIn 0.3s ease-out;
  }

  .user-message {
    flex-direction: row-reverse;
  }

  .message-avatar {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
  }

  .message-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .user-message .message-avatar {
    background: linear-gradient(135deg, var(--amaranto-violet), var(--amaranto-bright));
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    font-size: 1rem;
    border-radius: 50%;
  }

  .message-content {
    flex: 1;
    max-width: 75%;
  }

  .message-bubble {
    background: white;
    padding: 14px 18px;
    border-radius: 18px;
    box-shadow: var(--shadow-sm);
    line-height: 1.6;
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .user-message .message-bubble {
    background: linear-gradient(135deg, var(--amaranto-primary), var(--amaranto-medium));
    color: white;
    margin-left: auto;
    border: none;
  }

  .message-bubble p {
    margin: 0 0 10px 0;
    color: inherit;
  }

  .message-bubble p:last-child {
    margin-bottom: 0;
  }

  .message-bubble ul {
    margin: 10px 0;
    padding-left: 20px;
  }

  .message-bubble li {
    margin: 6px 0;
    color: inherit;
  }

  .message-bubble strong {
    font-weight: 600;
    color: inherit;
  }

  .message-time {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 6px;
    padding: 0 4px;
  }

  .user-message .message-time {
    text-align: right;
    color: var(--text-muted);
  }

  /* Sugerencias rápidas */
  .quick-suggestions {
    padding: 12px 20px 16px;
    background: white;
    border-top: 1px solid var(--border-color);
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    overflow-x: auto;
    max-height: 120px;
    overflow-y: auto;
  }

  .quick-suggestions::-webkit-scrollbar {
    height: 4px;
    width: 4px;
  }

  .quick-suggestions::-webkit-scrollbar-track {
    background: transparent;
  }

  .quick-suggestions::-webkit-scrollbar-thumb {
    background: var(--amaranto-purple);
    border-radius: 2px;
  }

  .quick-suggestions::-webkit-scrollbar-thumb:hover {
    background: var(--amaranto-medium);
  }

  .suggestion-chip {
    background: var(--bg-tertiary);
    border: 1.5px solid var(--border-color);
    color: var(--text-primary);
    padding: 8px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .suggestion-chip:hover {
    background: linear-gradient(135deg, var(--amaranto-light), var(--amaranto-purple));
    border-color: var(--amaranto-purple);
    color: white;
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .suggestion-chip:active {
    transform: translateY(0);
  }

  /* Indicador de escritura */
  .typing-indicator {
    display: none;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    background: white;
  }

  .typing-indicator.active {
    display: flex;
  }

  .typing-dots {
    display: flex;
    gap: 4px;
  }

  .typing-dots span {
    width: 8px;
    height: 8px;
    background: var(--amaranto-medium);
    border-radius: 50%;
    animation: typingBounce 1.4s infinite ease-in-out;
  }

  .typing-dots span:nth-child(1) {
    animation-delay: -0.32s;
  }

  .typing-dots span:nth-child(2) {
    animation-delay: -0.16s;
  }

  .typing-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  /* Área de input */
  .chat-input-container {
    background: white;
    border-top: 1px solid var(--border-color);
    padding: 16px 20px 12px;
  }

  .chat-input-wrapper {
    display: flex;
    gap: 10px;
    align-items: flex-end;
    background: var(--bg-secondary);
    border: 2px solid var(--border-color);
    border-radius: 24px;
    padding: 8px 12px;
    transition: all 0.2s ease;
  }

  .chat-input-wrapper:focus-within {
    border-color: var(--amaranto-medium);
    background: white;
    box-shadow: 0 0 0 3px rgba(168, 85, 163, 0.1);
  }

  .input-action-btn {
    background: transparent;
    border: none;
    font-size: 1.3rem;
    cursor: pointer;
    padding: 4px;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .input-action-btn:hover {
    transform: scale(1.2);
  }

  .chat-input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: inherit;
    font-size: 0.95rem;
    resize: none;
    outline: none;
    max-height: 120px;
    line-height: 1.5;
    padding: 4px 0;
    color: var(--text-primary);
  }

  .chat-input::placeholder {
    color: var(--text-muted);
  }

  .send-btn {
    background: linear-gradient(135deg, var(--amaranto-primary), var(--amaranto-medium));
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .send-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 4px 12px rgba(107, 45, 92, 0.3);
    background: linear-gradient(135deg, var(--amaranto-medium), var(--amaranto-light));
  }

  .send-btn:active {
    transform: scale(0.95);
  }

  .send-btn svg {
    width: 18px;
    height: 18px;
    stroke: white;
    stroke-width: 2;
  }

  .chat-footer-info {
    margin-top: 8px;
    text-align: center;
  }

  .powered-by {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .ai-icon {
    width: 14px;
    height: 14px;
    color: var(--amaranto-medium);
  }

  /* Animaciones */
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.1);
    }
  }

  @keyframes messageSlideIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes typingBounce {
    0%, 80%, 100% {
      transform: scale(0);
      opacity: 0.5;
    }
    40% {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .chat-fab {
      width: 56px;
      height: 56px;
      bottom: 20px;
      right: 20px;
    }

    .chat-icon,
    .close-icon {
      width: 24px;
      height: 24px;
    }

    .chat-container {
      bottom: 88px;
      right: 20px;
      left: 20px;
      width: auto;
      max-width: none;
      height: calc(100vh - 140px);
      max-height: none;
    }

    .message-content {
      max-width: 85%;
    }
  }

  @media (max-width: 480px) {
    .chat-container {
      bottom: 0;
      right: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      max-height: 100vh;
      border-radius: 0;
    }

    .chat-header {
      border-radius: 0;
      padding: 16px;
    }

    .chat-fab {
      bottom: 16px;
      right: 16px;
    }
  }
</style>

<script>
  // Base de conocimientos del amaranto
  const amarantoKnowledge = {
    beneficios: {
      keywords: ['beneficio', 'beneficios', 'propiedades', 'ventaja', 'ventajas', 'bueno', 'salud'],
      response: `El amaranto es un superalimento con múltiples beneficios:

• **Alto contenido proteico**: 14-16% de proteína de alta calidad con todos los aminoácidos esenciales
• **Rico en calcio**: Contiene hasta 3 veces más calcio que la leche
• **Libre de gluten**: Perfecto para personas celíacas o con intolerancia
• **Fuente de hierro**: Excelente para prevenir la anemia
• **Alto en fibra**: Mejora la digestión y salud intestinal
• **Contiene lisina**: Aminoácido esencial raro en cereales

¿Te gustaría saber más sobre algún beneficio específico?`
    },
    nutricional: {
      keywords: ['nutricional', 'nutrición', 'proteína', 'proteinas', 'vitaminas', 'minerales', 'calorias', 'gluten'],
      response: `**Información Nutricional del Amaranto (por 100g):**

🔸 Calorías: 371 kcal
🔸 Proteínas: 13.6g (alta calidad biológica)
🔸 Carbohidratos: 65g
🔸 Fibra: 7g
🔸 Grasas: 7g (mayormente insaturadas)

**Minerales destacados:**
• Calcio: 159mg
• Hierro: 7.6mg
• Magnesio: 248mg
• Fósforo: 557mg

**Vitaminas:**
• Vitamina C, E, y complejo B
• Ácido fólico

✅ **Sin gluten** - Apto para celíacos
✅ Alto valor biológico proteico

¿Necesitas más información nutricional específica?`
    },
    recetas: {
      keywords: ['receta', 'recetas', 'preparar', 'preparación', 'cocinar', 'comer', 'consumir', 'usar', 'atole', 'alegria', 'alegrías', 'como se prepara', 'cómo se prepara'],
      response: `¡Te comparto algunas formas deliciosas de preparar amaranto!

**🥣 Atole de Amaranto:**
- Hierve 1 taza de amaranto en 4 tazas de agua
- Agrega canela y panela al gusto
- Sirve caliente

**🍪 Alegrías (dulce tradicional):**
